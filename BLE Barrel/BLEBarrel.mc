module BLEBarrel {

// const DEVICE_NAME = "ONE "; // Full name is "ONE R DV6W5S";
// const DEVICE_NAME2 = "GO2 ";
// const DEVICE_NAME3 = "X3 "; // Full name is "X3 7MN5JB";
// const DEVICE_NAME4 = "GO3 ";
// const DEVICE_NAME5 = "Ace ";
